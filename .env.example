# agent_swarm 配置示例：复制为 .env 并按需修改。所有项都有安全默认值，可以一个都不配。

# ---- 安全 ----
# JWT 签名密钥（生产环境务必设置，否则用内置开发密钥，token 可被伪造）
# AGENT_SWARM_JWT_SECRET=<random-long-string>

# ---- 静态内容落库加密（可选，强烈推荐）----
# 设置后以下内容将以密文落库（工作区描述/笔记/会话标题、任务指令/结果/错误、事件流原文）：
#   AGENT_SWARM_ENC_KEY=<random-long-string>
# 恢复密钥（可选）：主密钥丢失时用它解密历史密文；建议与主密钥分开保存
#   AGENT_SWARM_ENC_KEY_RECOVERY=<another-random-long-string>
#
# ⚠️ 不设置 = 全部明文落库。
# ⚠️ 密钥丢失 = 加密后的历史内容永久不可读（平台本身不受影响，新数据用新密钥继续存）。
#    请务必备份密钥（密码管理器 / 离线介质）。生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- 后台管理（#/admin 独立登录；不配则用默认 admin / Admin123!@#）----
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<change-me>

# ---- 飞书渠道 nexus-feishu（不配则整个模块不启动）----
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ---- 其它 ----
# AGENT_SWARM_DB=data/agent_swarm.db    # SQLite 路径
# AGENT_SWARM_PUBLIC_URL=               # 公网地址（覆盖 Agent Card / 安装脚本里推导的 URL）
# AGENT_SWARM_CALL_TIMEOUT=3600         # A2A 任务超时秒数
