{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "typeRoots": ["../opencode/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
